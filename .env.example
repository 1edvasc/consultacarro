# Porta HTTP
PORT=3000
# URL pública do site (canonical, sitemap)
SITE_URL=http://localhost:3000
# Token da API PLACAS (https://apiplacas.com.br). Sem token, o site usa dados de demonstração.
API_PLACAS_TOKEN=
# Tempo de cache de cada placa, em horas (cada consulta nova custa dinheiro)
CACHE_TTL_HOURS=720
# Consultas novas (fora do cache) por IP por hora
RATE_LIMIT_PER_HOUR=20
# ID do AdSense (ca-pub-...). Vazio = sem anúncios.
ADSENSE_CLIENT=
# Deixar buscadores indexarem /placa/* (cada robô que visita uma placa nova gera custo)
INDEX_PLATE_PAGES=false
